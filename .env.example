# =============================================================================
# .env.example — copy to .env and fill in.   cp .env.example .env
# Never commit .env. Values in <angle brackets> MUST be replaced.
# Full explanation of every setting: docs/02-setup.md and docs/04-features.md
# =============================================================================

# ── Mode: local-first (no cloud databases needed) ───────────────────────────
SECRETS_BACKEND=local          # local (.env) | gcp (Secret Manager)
VECTOR_BACKEND=chroma          # chroma (local folder) | qdrant (cloud)
CACHE_BACKEND=local            # local (JSON files) | redis
STORAGE_BACKEND=local
LOG_BACKEND=both
LOG_LEVEL=INFO
ANONYMIZED_TELEMETRY=False     # turns off Chroma telemetry

# ── Where the UI finds the API ──────────────────────────────────────────────
# Use 127.0.0.1, not localhost (localhost can hang on Windows).
RAG_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
API_TIMEOUT_SECONDS=900        # scanned PDFs can take minutes to index
API_CONNECT_TIMEOUT_SECONDS=10

# ── LLM and embeddings ──────────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBED_PROVIDER=openai
DEFAULT_EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=<sk-...>

# ── Authentication (Firebase) ───────────────────────────────────────────────
AUTH_PROVIDER=firebase
FIREBASE_WEB_API_KEY=<AIza...>
# One line, NOT wrapped in quotes. See docs/02-setup.md section 2.7.
FIREBASE_SERVICE_ACCOUNT_JSON=<{"type":"service_account",...}>
# Any long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_SERVICE_SECRET=<random-string>

# ── Chainlit UI ─────────────────────────────────────────────────────────────
CHAINLIT_AUTH_SECRET=<run: chainlit create-secret>
OAUTH_GOOGLE_CLIENT_ID=<...apps.googleusercontent.com>
OAUTH_GOOGLE_CLIENT_SECRET=<...>
# CHAINLIT_URL=https://your-ui.example.com   # only when deployed

# ── PII masking at ingestion (docs/04-features.md 4.13) ─────────────────────
PII_MASKING_ENABLED=true
PII_SKIP_CATEGORIES=DATE_ISO,DATE_DMY,DATE,SALARY

# ── OCR (optional) ──────────────────────────────────────────────────────────
DEFAULT_OCR_METHOD=easyocr     # easyocr | tesseract | google_docai | aws_textract | azure_di | none
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# GCP_PROJECT_ID=
# GCP_LOCATION=us
# GCP_PROCESSOR_ID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1
# AZURE_DI_ENDPOINT=
# AZURE_DI_KEY=

# ── LLM resilience (defaults shown) ─────────────────────────────────────────
# LLM_MAX_RETRIES=3
# LLM_REQUEST_TIMEOUT=60
# LLM_RPM_LIMIT=20
# LLM_TPM_LIMIT=50000
# LLM_CB_FAILURES=5
# LLM_CB_TIMEOUT=60

# ── Optional services ───────────────────────────────────────────────────────
# Postgres: audit log, conversation memory, quotas, FinOps
# AUDIT_DB_URL=postgresql://user:password@host:5432/dbname
# Redis: shared semantic cache, persistent RAGAS evaluations
# REDIS_URL=redis://:password@host:6379/0
# Qdrant Cloud (VECTOR_BACKEND=qdrant)
# QDRANT_URL=https://xxxx.qdrant.io
# QDRANT_API_KEY=

# ── Other LLM providers (optional) ──────────────────────────────────────────
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=
# AZURE_OPENAI_DEPLOYMENT=
